<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             xmlns:local="clr-namespace:ColumnCustomization"
             x:Class="ColumnCustomization.MainPage">

    <ContentPage.BindingContext>
        <local:ProductInventoryViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <local:QuantityColorConverter x:Key="QuantityColorConverter" />
        <local:StockStatusColorConverter x:Key="StockStatusColorConverter" />
        <Style TargetType="syncfusion:DataGridHeaderCell">
            <Setter Property="FontFamily"
              Value="Roboto-Medium" />
        </Style>
        <Style TargetType="syncfusion:DataGridCell">
            <Setter Property="FontFamily"
              Value="Roboto-Regular" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.Content>
        <syncfusion:SfDataGrid ItemsSource="{Binding Products}"
                         AutoGenerateColumnsMode="None">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:DataGridImageColumn MappingName="ProductImage"
                                          HeaderText="Product Image"
                                          Width="150" />
                <syncfusion:DataGridTextColumn MappingName="ProductName"
                                         HeaderText="Product Name"
                                         Width="150" />
                <syncfusion:DataGridTextColumn MappingName="SKU"
                                         HeaderText="SKU" />
                <syncfusion:DataGridTextColumn MappingName="Category"
                                         HeaderText="Category"
                                         Width="120" />
                <syncfusion:DataGridTextColumn MappingName="Supplier"
                                         HeaderText="Supplier"
                                         Width="150" />
                <syncfusion:DataGridNumericColumn MappingName="QuantityInStock"
                                            HeaderText="Quantity"
                                            Format="N0"
                                            HeaderTextAlignment="End"
                                            CellTextAlignment="End">
                    <syncfusion:DataGridNumericColumn.CellTemplate>
                        <DataTemplate>
                            <Label Text="{Binding QuantityInStock, StringFormat='{0:N0}'}"
                                TextColor="{Binding QuantityInStock, Converter={StaticResource QuantityColorConverter}}"
                                HorizontalTextAlignment="End"
                                VerticalTextAlignment="Center" />
                        </DataTemplate>
                    </syncfusion:DataGridNumericColumn.CellTemplate>
                </syncfusion:DataGridNumericColumn>
                <syncfusion:DataGridNumericColumn MappingName="ReorderLevel"
                                            HeaderText="Reorder Level"
                                            Width="120"
                                            Format="N0"
                                            HeaderTextAlignment="End"
                                            CellTextAlignment="End" />
                <syncfusion:DataGridTextColumn MappingName="StockStatus"
                                         HeaderText="Stock Status"
                                         Width="125">
                    <syncfusion:DataGridTextColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="10,5"
                                 Margin="10"
                                 StrokeShape="RoundRectangle 5"
                                BackgroundColor="{Binding StockStatus, Converter={StaticResource StockStatusColorConverter}}">
                                <Label Text="{Binding StockStatus}"
                                    TextColor="Black"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </syncfusion:DataGridTextColumn.CellTemplate>
                </syncfusion:DataGridTextColumn>
                <syncfusion:DataGridNumericColumn MappingName="UnitPrice"
                                            HeaderText="Unit Price"
                                            Format="C"
                                            CellTextAlignment="End" />
                <syncfusion:DataGridNumericColumn MappingName="Discount"
                                            HeaderText="Discount"
                                            Format="N0"
                                            CellTextAlignment="End">
                    <syncfusion:DataGridNumericColumn.CellTemplate>
                        <DataTemplate>
                            <Label Text="{Binding Discount, StringFormat='{0:N0}%'}"
                                HorizontalTextAlignment="End"
                                VerticalTextAlignment="Center" />
                        </DataTemplate>
                    </syncfusion:DataGridNumericColumn.CellTemplate>
                </syncfusion:DataGridNumericColumn>
                <syncfusion:DataGridNumericColumn MappingName="TotalValue"
                                            HeaderText="Total Value"
                                            Width="130"
                                            Format="C"
                                            HeaderTextAlignment="End"
                                            CellTextAlignment="End" />
                <syncfusion:DataGridDateColumn MappingName="ManufactureDate"
                                         HeaderText="Manufactured On"
                                         Width="150"
                                         Format="dd-MMM-yyyy" />
                <syncfusion:DataGridDateColumn MappingName="ExpiryDate"
                                         HeaderText="Expiry Date"
                                         Width="130"
                                         Format="dd-MMM-yyyy" />
                <syncfusion:DataGridCheckBoxColumn MappingName="IsDiscontinued"
                                             HeaderText="Discontinued"
                                             Width="120" />
                <syncfusion:DataGridTextColumn MappingName="WarehouseLocation"
                                         Width="140"
                                         HeaderText="Warehouse" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
    </ContentPage.Content>
</ContentPage>
